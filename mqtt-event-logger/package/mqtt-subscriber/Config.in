menuconfig BR2_PACKAGE_MQTT_SUBSCRIBER
	bool "mqtt-subscriber"
	select BR2_TOOLCHAIN_BUILDROOT_CXX
	select BR2_PACKAGE_OPENSSL
	help
	  User-space application that connects to a Mosquitto broker and listens for messages on configurable topics.
	  Converts incoming MQTT messages into a structured event format and either logs them or forwards them to the kernel module through the character device interface.


if BR2_PACKAGE_MQTT_SUBSCRIBER

config BR2_CHAR_HASH
	string
	default "\x23"

config BR2_PACKAGE_MQTT_SUBSCRIBER_MQTT_HOST
	string "MQTT host"
	default "mqtt://localhost:1883"

config BR2_PACKAGE_MQTT_SUBSCRIBER_MQTT_TOPIC
	string "MQTT topic"
	default "\\$(BR2_CHAR_HASH)"
endif
